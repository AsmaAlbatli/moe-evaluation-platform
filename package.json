{
  "name": "moe-evaluation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "منصة تحليل نتائج التقويم المدرسي وبناء خطط التحسين",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:fixtures": "vite-node src/test/make-fixtures.ts",
    "test:e2e": "node scripts/e2e-check.mjs",
    "db:use:sqlite": "node scripts/use-db-provider.mjs sqlite",
    "db:use:postgres": "node scripts/use-db-provider.mjs postgres",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "setup": "prisma generate && prisma db push",
    "postinstall": "prisma generate",
    "vendor:assets": "node scripts/copy-vendor-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-node": "^6",
    "vitest": "^5.0.4"
  }
}