# =====================================================================
#  منصة تحليل نتائج التقويم المدرسي وبناء خطط التحسين
#  ملف نموذج لمتغيرات البيئة — انسخه إلى ‎.env‎ ثم عدّل القيم
#  ⚠️ لا ترفع هذا الملف إلى Git ولا تضع فيه أسرارًا حقيقية.
# =====================================================================


# ---------------------------------------------------------------------
# 1) قاعدة البيانات
# ---------------------------------------------------------------------
# التطوير المحلي (SQLite):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# النشر على Vercel (PostgreSQL) — استخدم رابط الاتصال من مزود القاعدة:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
#
# لتبديل مخطط Prisma بين SQLite و PostgreSQL:
#   npm run db:use:postgres
#   npm run db:use:sqlite


# ---------------------------------------------------------------------
# 2) مفاتيح حماية الملفات المرفوعة
#    مولّد مقترح:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    ⚠️ استخدم قيمة جديدة لكل بيئة، ولا تشاركها.
# ---------------------------------------------------------------------
FILE_SIGNING_SECRET="ضع- هنا- قيمة- عشوائية- طويلة- لا- تقل- عن- 64- حرفًا"
# صلاحية رابط الملف المحمي (بالثواني). الافتراضي ساعة.
FILE_URL_TTL_SECONDS="3600"


# ---------------------------------------------------------------------
# 3) تخزين الملفات
#    القيم: local | blob | s3
#    - local: مجلد ./storage داخل الخادم (مناسب للتطوير أو الاستضافة الذاتية)
#    - blob : Vercel Blob (مناسب للنشر على Vercel)
#    - s3   : أي تخزين متوافق مع S3 (AWS S3, Cloudflare R2, MinIO)
# ---------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# S3 / R2 / MinIO
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""


# ---------------------------------------------------------------------
# 4) الذكاء الاصطناعي (اختياري)
#    عند غياب هذه القيم تعمل المنصة بمحرك القواعد فقط، وتعرض
#    توصيات قائمة على قواعد دون أن تدّعي تحليلًا ذكيًا.
#    المفتاح يُقرأ في الخادم فقط ولا يُرسل إلى المتصفح إطلاقًا.
# ---------------------------------------------------------------------
AI_ENABLED="false"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_SECONDS="60"


# ---------------------------------------------------------------------
# 5) بيانات المنصة
# ---------------------------------------------------------------------
# المسار الذي تُخزَّن عنده الملفات المرفوعة على القرص (يُتجاهل في Git)
NEXT_PUBLIC_APP_NAME="منصة تحليل نتائج التقويم المدرسي وبناء خطط التحسين"